# cmd.c/cmd.h are generated by feeding all of bk's command names
# (embedded in cmd.pl's own __DATA__ section, plus names scraped out of
# bk.sh and bkd_*.c at "build" time) through gperf to build a perfect
# hash lookup table. This mirrors the `cmd.c cmd.h: cmd.pl bk.sh
# $(filter bkd_%,$(SRCS))` rule that used to live in src/Makefile.
genrule(
    name = "gen_cmd",
    srcs = ["cmd.pl", "bk.sh"] + glob(["bkd_*.c"]),
    outs = ["cmd.c", "cmd.h"],
    cmd = """
        set -e
        gperf=$$(pwd)/$(location @gperf//:gperf)
        workdir=$$(mktemp -d)
        cp $(location cmd.pl) $(location bk.sh) "$$workdir/"
        for f in $(SRCS); do
            base=$$(basename "$$f")
            case "$$base" in bkd_*.c) cp "$$f" "$$workdir/$$base" ;; esac
        done
        (cd "$$workdir" && GPERF="$$gperf" perl cmd.pl)
        cp "$$workdir/cmd.c" "$(location cmd.c)"
        cp "$$workdir/cmd.h" "$(location cmd.h)"
    """,
    tools = [
        "cmd.pl",
        "@gperf//:gperf",
    ],
    visibility = ["//visibility:public"],
)

# bkver.c embeds the platform string (from utils/bk_version) and the
# build timestamp/directory; it must be regenerated on every build,
# mirroring the `bkver.c: utils/bk_version FORCE` rule in src/Makefile.
genrule(
    name = "gen_bkver",
    srcs = ["utils/bk_version"],
    outs = ["bkver.c"],
    cmd = """
        set -e
        platform=$$(sh $(location utils/bk_version))
        {
            echo '#include "sccs.h"'
            echo "char *bk_platform = \\"$$platform\\";"
            echo "int test_release = 0;"
            echo "time_t bk_build_timet = $$(date +%s);"
            echo "char *bk_build_dir = \\"bazel-build\\";"
        } > $@
    """,
)

# kw2val_lookup.c is #include-d by slib.c; it's generated by scanning
# slib.c's kw2val() switch statement and feeding the keywords through
# gperf. Mirrors `kw2val_lookup.c: slib.c kw2val.pl` in src/Makefile.
genrule(
    name = "gen_kw2val",
    srcs = ["slib.c", "kw2val.pl"],
    outs = ["kw2val_lookup.c"],
    cmd = """
        set -e
        gperf=$$(pwd)/$(location @gperf//:gperf)
        workdir=$$(mktemp -d)
        cp $(location slib.c) $(location kw2val.pl) "$$workdir/"
        (cd "$$workdir" && GPERF="$$gperf" perl kw2val.pl slib.c)
        cp "$$workdir/kw2val_lookup.c" "$@"
    """,
    tools = [
        "kw2val.pl",
        "@gperf//:gperf",
    ],
)

cc_binary(
    name = "bk",
    srcs = _BK_SRCS + glob(["*.h"]) + [
        ":gen_cmd",
        ":gen_bkver",
    ] + select({
        "@platforms//os:windows": ["//src/win32:gen_bkres"],
        "//conditions:default": [],
    }),
    includes = ["."],
    copts = select({
        "@platforms//os:macos": ["-DNOPROC"],
        "@platforms//os:windows": [
            "-DWIN32",
            "-D_WIN32",
            "-DWINVER=0x0500",
            "-D_WIN32_WINNT=0x0500",
            "-DPCRE2_STATIC",
        ],
        "//conditions:default": [],
    }),
    defines = ["USE_TRACE"],
    linkopts = select({
        "@platforms//os:macos": ["-lresolv"],
        "@platforms//os:windows": [
            "-lws2_32",
            "-ladvapi32",
            "-luser32",
            "-lkernel32",
            "-lshell32",
            "-lpsapi",
            "-lole32",
            "-luuid",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":configvars",
        ":kw2val_lookup",
        "//src/libc",
        "@pcre2//:pcre2",
        "@tomcrypt//:tomcrypt",
        "@tommath//:tommath",
    ],
)

cc_binary(
    name = "bkg",
    srcs = [
