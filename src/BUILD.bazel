load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "flags.l",
    "slib.c",
    "utils/extractor.c",
])

# cc_binary's `srcs` attribute rejects non-C/C++ extensions (unlike
# cc_library's `hdrs`), but configvars.def is #include-d verbatim by
# config.h, so it's exposed to //src:bk via this tiny header-only lib.
cc_library(
    name = "configvars",
    hdrs = ["configvars.def"],
    includes = ["."],
)

# kw2val_lookup.c is #include-d verbatim by slib.c (not compiled on its
# own), so like configvars.def it's exposed via a header-only library
# rather than cc_binary's srcs (which rejects non-C/C++ extensions).
cc_library(
    name = "kw2val_lookup",
    hdrs = [":gen_kw2val"],
    includes = ["."],
)

