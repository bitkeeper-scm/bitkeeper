# Runtime text files and metadata
genrule(
    name = "gen_bkmsg",
    srcs = ["bkmsg.doc"],
    outs = ["bkmsg.txt"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_version",
    srcs = ["version.sh", "utils/bk_version"],
    outs = ["version"],
    cmd = """
        set -e
        bash $(location version.sh) > "$@"
    """,
)

# Helper / wrapper shell scripts
_WRAPPER_SCRIPTS = [
    "uuwrap",
    "unuuwrap",
    "gzip_uuwrap",
    "ungzip_uuwrap",
    "b64wrap",
    "unb64wrap",
    "gzip_b64wrap",
    "ungzip_b64wrap",
]

[
    genrule(
        name = "gen_" + s,
        srcs = [s + ".sh"],
        outs = [s],
        cmd = "cp $< $@ && chmod +x $@",
    )
    for s in _WRAPPER_SCRIPTS
]

genrule(
    name = "gen_bk_script",
    srcs = select({
        "@platforms//os:windows": ["port/win32_platform.sh", "bk.sh"],
        "//conditions:default": ["port/unix_platform.sh", "bk.sh"],
    }),
    outs = ["bk.script"],
    cmd = """
        cat $(SRCS) > $@
        chmod +x $@
    """,
)

genrule(
    name = "gen_import_script",
    srcs = select({
        "@platforms//os:windows": ["port/win32_platform.sh", "import.sh"],
        "//conditions:default": ["port/unix_platform.sh", "import.sh"],
    }),
    outs = ["import"],
    cmd = """
        cat $(SRCS) > $@
        chmod +x $@
    """,
)

