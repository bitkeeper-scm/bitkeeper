load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# -*-Python-*-
#
# BitKeeper's small platform/utility library ("libc"). Vendored copies
# of zlib and lz4 that historically lived under libc/zlib and
# libc/lz4 are no longer built here -- BitKeeper links against the
# real zlib/lz4 packages fetched by MODULE.bazel instead (see
# //src:bk). libc/win32 is Windows-only support code and is excluded
# from the non-Windows build.

# fslayer.h and the fslayer_<fn>_stub.c files are 100% generated (from
# the fixed __DATA__ function list at the bottom of gen_fslayer.pl) by
# fslayer/gen_fslayer.pl; nothing here depends on the build host.
_FSLAYER_FCNS = [
    "open", "close", "read", "write", "lseek", "lstat", "linkcount",
    "fstat", "stat", "unlink", "rename", "chmod", "link", "symlink",
    "getdir", "access", "utime", "mkdir", "rmdir", "rmIfRepo",
    "realBasename",
]

genrule(
    name = "gen_fslayer",
    srcs = ["fslayer/gen_fslayer.pl", "fslayer/win_remap.h"],
    outs = ["fslayer/fslayer.h"] +
           ["fslayer/fslayer_%s_stub.c" % fn for fn in _FSLAYER_FCNS],
    cmd = """
        set -e
        workdir=$$(mktemp -d)
        mkdir "$$workdir/fslayer"
        cp $(location fslayer/gen_fslayer.pl) "$$workdir/fslayer/"
        (cd "$$workdir" && perl fslayer/gen_fslayer.pl)
        for out in $(OUTS); do
            cp "$$workdir/fslayer/$$(basename $$out)" "$$out"
        done
    """,
)

# string/str.cfg used to be produced by compiling a test program
# (string/mk_str_cfg.pl) to detect, on the build host, whether the
# system's libc already provides memmem()/strcasestr()/strndup()/
# strsep(). Since we now target known, modern C11 platforms (glibc on
# Linux, libc on macOS) that always provide these BSD/GNU extensions,
# we generate an empty str.cfg (meaning "the system already has all of
# these") instead of doing that detection at build time. A Windows/
# MSVC build, which lacks these functions, can select() a non-empty
# str.cfg here in the future.
genrule(
    name = "str_cfg",
    outs = ["string/str.cfg"],
    cmd = select({
        "@platforms//os:windows": """cat << 'EOF' > $@
// autogenerated for windows/mingw
#define BK_STR_MEMMEM
#define BK_STR_STRCASESTR
#define BK_STR_STRNDUP
#define BK_STR_STRSEP
EOF
""",
        "//conditions:default": "echo '// no extra string functions needed on this platform' > $@",
    }),
)

cc_library(
    name = "bkstyle",
    hdrs = ["style.h"],
    visibility = ["//visibility:public"],
)

_STDIO_EXCLUDE_FCNS = [
    "_fileno", "_fseeko", "_ftello", "clrerr", "feof", "ferror", "fgetwc",
    "fgetwln", "fgetws", "fileno", "flockfile", "fputwc", "fputws", "fwide",
    "fwprintf", "fwscanf", "getc", "getchar", "gets", "getw", "getwc",
    "getwchar", "mktemp", "perror", "putc", "putchar", "putw", "putwc",
    "putwchar", "snprintf_ss", "swprintf", "swscanf", "tempnam", "tmpfile",
    "tmpnam", "ungetwc", "vfwprintf", "vfwscanf", "vsnprintf_ss", "vswprintf",
    "vswscanf", "vwprintf", "vwscanf", "wprintf", "wscanf",
]

cc_library(
    name = "libc",
    srcs = glob(
        ["**/*.c", "**/*.h"],
        exclude = [
            "win32/**",
            "mdbm/mtst.c",
            "fslayer/gen_fslayer.pl",
            "stdio/mkstemp.c",
        ] + ["stdio/%s.c" % fn for fn in _STDIO_EXCLUDE_FCNS],
    ) + select({
        "@platforms//os:windows": [
            "win32/err2errno.c",
            "win32/nt_link.c",
            "win32/nt_stat.c",
            "win32/reg.c",
            "win32/runas.c",
            "win32/w32sock.c",
            "win32/wapi_intf.c",
            "win32/wcrt_intf.c",
        ],
        "//conditions:default": [
            "stdio/mkstemp.c",
        ],
    }) + [":gen_fslayer"],
    hdrs = glob(
        ["**/*.h"],
        exclude = ["win32/**"],
    ) + select({
        "@platforms//os:windows": glob(["win32/**/*.h"]),
        "//conditions:default": [],
    }) + [":str_cfg"],
    # vfwprintf.c is not compiled as its own translation unit (it isn't
    # in the historical STDIO_OBJS list) -- it's textually #include'd
    # by vfprintf.c, so it needs to be on disk but must not be compiled
    # standalone (that would duplicate-define its symbols).
    textual_hdrs = ["stdio/vfwprintf.c"],
    includes = [
        "fslayer",
        ".",
    ],
    defines = [
        "LZ4_DISABLE_DEPRECATE_WARNINGS",
        "USE_TRACE",
    ] + select({
        "@platforms//os:windows": [
            "WIN32",
            "_WIN32",
            "WINVER=0x0500",
            "_WIN32_WINNT=0x0500",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": [
            "-lws2_32",
            "-ladvapi32",
            "-luser32",
            "-lkernel32",
            "-lshell32",
            "-lpsapi",
            "-lole32",
            "-luuid",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@lz4",
        "@zlib//:z",
    ],
)

cc_binary(
    name = "mtst",
    srcs = ["mdbm/mtst.c"],
    deps = [":libc"],
    visibility = ["//visibility:public"],
)


