load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "test_support",
    srcs = glob(
        ["*"],
        exclude = ["BUILD.bazel"],
    ),
)

TEST_DATA = [
    ":test_support",
    "//:release_notes",
    "//doc:bk_refcard",
    "//man:bkhelp",
    "//src:bk",
    "//src:contrib",
    "//src:data",
    "//src:dspecs",
    "//src:gen_cmd",
    "//src:lscripts",
    "//src:scripts",
    "//src:slib.c",
    "//src:www",
    "//src/gui:gui_package",
    "//src/libc:mtst",
]

# Serial tests as identified by src/t/Makefile
SERIAL_TESTS = [
    "t.bkd-svc",
    "t.installer",
    "t.proxy-win32",
    "t.uniq",
]

ALL_TEST_FILES = glob(["t.*"])

[
    sh_test(
        name = t.replace(".", "_"),
        srcs = ["test_runner.sh"],
        args = [t],
        data = TEST_DATA,
        tags = ["exclusive"] if t in SERIAL_TESTS else [],
    )
    for t in ALL_TEST_FILES
]
