"""BitKeeper Bazel module.

All third-party libraries are built from upstream packages that Bazel
fetches itself (either from the Bazel Central Registry, or -- for
libraries not published there -- directly from the upstream project's
release tarball). None of the copies vendored under src/ are used to
build the project anymore.
"""

module(
    name = "bitkeeper",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "zlib", version = "1.3.1.bcr.8")
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")

# ---------------------------------------------------------------------
# Libraries that are not published to the Bazel Central Registry are
# fetched straight from their upstream release tarballs and built with
# BUILD files we provide under //third_party. This keeps the actual
# library source out of this repository while still building it with
# Bazel (not the copies historically vendored under src/tomcrypt,
# src/tommath and src/gui/tcltk/pcre).
# ---------------------------------------------------------------------
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pcre1",
    urls = [
        "https://downloads.sourceforge.net/project/pcre/pcre/8.45/pcre-8.45.tar.gz",
        "https://ftp.pcre.org/pub/pcre/pcre-8.45.tar.gz",
    ],
    sha256 = "4e6ce03e0336e8b4a3d6c2b70b1c5e18590a5673a98186da90d4f33c23defc09",
    strip_prefix = "pcre-8.45",
    build_file = "//third_party/pcre1:BUILD.pcre1.bazel",
)

http_archive(
    name = "tomcrypt",
    urls = ["https://github.com/libtom/libtomcrypt/archive/refs/tags/v1.18.2.tar.gz"],
    sha256 = "d870fad1e31cb787c85161a8894abb9d7283c2a654a9d3d4c6d45a1eba59952c",
    strip_prefix = "libtomcrypt-1.18.2",
    build_file = "//third_party/tomcrypt:BUILD.tomcrypt.bazel",
)

http_archive(
    name = "tommath",
    urls = ["https://github.com/libtom/libtommath/archive/refs/tags/v1.3.0.tar.gz"],
    sha256 = "6d099e93ff00fa9b18346f4bcd97dcc48c3e91286f7e16c4ac5515a7171c3149",
    strip_prefix = "libtommath-1.3.0",
    build_file = "//third_party/tommath:BUILD.tommath.bazel",
)
