load("@rules_cc//cc:defs.bzl", "cc_library")

# BUILD file for the upstream PCRE (1.x) release tarball fetched by
# MODULE.bazel. BitKeeper's C sources call the classic PCRE1 API
# (pcre_compile/pcre_exec/...), so we build the real PCRE1 sources
# here rather than PCRE2 (which has an incompatible, newer API).
#
# PCRE1 normally generates pcre.h/config.h/pcre_chartables.c via
# ./configure. The release tarball ships pre-built fallback versions
# of those exact same generated files for platforms without autotools
# (pcre.h.generic, config.h.generic, pcre_chartables.c.dist), which we
# use here instead of invoking configure. This keeps the build
# hermetic and portable across Linux, macOS and Windows.

genrule(
    name = "gen_pcre_h",
    srcs = ["pcre.h.generic"],
    outs = ["pcre.h"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_config_h",
    srcs = ["config.h.generic"],
    outs = ["config.h"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_chartables",
    srcs = ["pcre_chartables.c.dist"],
    outs = ["pcre_chartables.c"],
    cmd = "cp $< $@",
)

cc_library(
    name = "pcre1",
    srcs = [
        "pcre_byte_order.c",
        "pcre_compile.c",
        "pcre_config.c",
        "pcre_dfa_exec.c",
        "pcre_exec.c",
        "pcre_fullinfo.c",
        "pcre_get.c",
        "pcre_globals.c",
        "pcre_maketables.c",
        "pcre_newline.c",
        "pcre_ord2utf8.c",
        "pcre_refcount.c",
        "pcre_string_utils.c",
        "pcre_study.c",
        "pcre_tables.c",
        "pcre_ucd.c",
        "pcre_valid_utf8.c",
        "pcre_version.c",
        "pcre_xclass.c",
        ":gen_chartables",
        # Private headers used across the library's own .c files.
        "pcre_internal.h",
        "ucp.h",
        ":gen_config_h",
    ],
    hdrs = [":gen_pcre_h"],
    defines = ["HAVE_CONFIG_H"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
