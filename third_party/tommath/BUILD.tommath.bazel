load("@rules_cc//cc:defs.bzl", "cc_library")

# BUILD file for the upstream libtommath release tarball fetched by
# MODULE.bazel (see MODULE.bazel for the http_archive() that uses this
# file). This builds the real upstream sources directly with Bazel
# instead of the copy that used to be vendored under src/tommath.

cc_library(
    name = "tommath",
    srcs = glob(["*.c"]),
    hdrs = glob(["*.h"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)
